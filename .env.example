# ─────────────────────────────────────────────────────────────
# NoPS — Environment Variables (.env)
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# --- Database (local Postgres via Docker Compose) ---
# Direct connection to the local container — no pgbouncer, no Supabase pooler.
DATABASE_URL=postgresql://nops:nops_local_dev@db:5432/nops?schema=public
DIRECT_URL=postgresql://nops:nops_local_dev@db:5432/nops?schema=public
# Password for the Postgres container (must match docker-compose.yml)
POSTGRES_PASSWORD=nops_local_dev

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- App ---
# Comma-separated: every origin allowed to call the API (CORS), and the first entry is
# the base of every share link. Set this to your Vercel URL + tunnel URL.
# Example: https://your-app.vercel.app,https://api.yourdomain.com
APP_URL=http://localhost:5173
PORT=4000
# Set to 1 when running behind Cloudflare Tunnel.
TRUST_PROXY_HOPS=1
MAX_FILE_SIZE=15728640
VITE_APP_NAME=NoPS

# --- Cloudflare Tunnel ---
# Create a tunnel at https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
# Copy the token and paste it here.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# --- AI question understanding (optional) ---
OPENAI_API_KEY=
AI_MODEL=gpt-5-nano

# --- Data-source connectors ---
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-string
ALLOW_PRIVATE_CONNECTOR_HOSTS=false
MAX_SYNC_ROWS=100000

# --- Uploads ---
MAX_UPLOAD_ROWS=100000

# --- Signals: predictions (apps/ml) ---
ML_ENABLED=false
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SHARED_SECRET=replace-with-a-long-random-string
ML_TIMEOUT_MS=120000
ML_ALLOW_NO_SECRET=

# --- Billing (optional) ---
STRIPE_SECRET_KEY=

# --- Email (optional) ---
SMTP_URL=
REPORT_FROM=NoPS Reports <reports@nops.local>
