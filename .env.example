# --- Database ---
DATABASE_URL=postgresql://decisioniq:decisioniq@localhost:5432/decisioniq?schema=public

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- App ---
APP_URL=http://localhost:5173
PORT=4000
MAX_FILE_SIZE=15728640
VITE_APP_NAME=DecisionIQ

# --- AI question understanding (optional) ---
# When set, the chat endpoint uses Claude to interpret free-form questions; the
# deterministic engine still computes every number, and only the question + column
# names are sent to Claude (never your data rows). Unset = rule-based parser only
# (fully deterministic, no external calls).
ANTHROPIC_API_KEY=
# Model used for interpretation. claude-opus-5 is the default; claude-haiku-4-5 and
# claude-sonnet-5 are cheaper and usually sufficient for this narrow task.
AI_MODEL=claude-opus-5

# --- Data-source connectors ---
# Symmetric key used to encrypt saved connection credentials. Required in production.
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-string
# Allow connectors to reach private/loopback hosts (e.g. a local demo DB). Off by default (SSRF guard).
ALLOW_PRIVATE_CONNECTOR_HOSTS=false
# Max rows pulled per connector sync.
MAX_SYNC_ROWS=100000
