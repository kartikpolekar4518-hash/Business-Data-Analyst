# --- Database ---
DATABASE_URL=postgresql://decisioniq:decisioniq@localhost:5432/decisioniq?schema=public

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI (optional) ---
# Leave OPENAI_API_KEY blank to use the built-in deterministic analyst (no LLM needed).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App ---
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=15728640
