# --- Database ---
# Runtime connection: read by Prisma Client for every query, and validated at boot by
# apps/api/src/env.ts (the API refuses to start without it).
DATABASE_URL=postgresql://nops:nops@localhost:5432/nops?schema=public
# Migration connection: read by the Prisma CLI (migrate deploy / db push / db pull) and by
# nothing else — Prisma Client never opens it. Required on any host that runs a migration,
# `npm run db:migrate` included: schema.prisma declares directUrl, and the CLI fails with
# "Environment variable not found: DIRECT_URL" when this is unset. On a plain local
# Postgres it is simply the same value as DATABASE_URL.
DIRECT_URL=postgresql://nops:nops@localhost:5432/nops?schema=public

# --- Database (Supabase) ---
# Supabase serves two differently-routed connection strings per project (Settings ->
# Database). Use both: the pooler for the app, the direct connection for migrations.
# DATABASE_URL = the transaction pooler, port 6543, with ?pgbouncer=true:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL = the direct connection, port 5432:
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# On a project with no IPv6 route, use the session pooler instead (also port 5432):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Migrations must not go through the port-6543 transaction pooler: it keeps no session for
# the advisory locks and DDL that Prisma Migrate needs, which is exactly why DIRECT_URL is
# the non-pooled string. On a serverless host, also append &connection_limit=1 to
# DATABASE_URL so each instance holds one pooled connection rather than opening its own pool.

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- App ---
# Comma-separated: every origin allowed to call the API (CORS), and the first entry is
# the base of every share link. Surrounding spaces are trimmed, so "a.com, b.com" works.
APP_URL=http://localhost:5173
PORT=4000
# How many reverse proxies sit in front of the API. 0 = none (direct). Set this to the
# real hop count when deploying behind a load balancer / ingress / Replit, otherwise
# every caller shares one rate-limit bucket. Never set it higher than the true count:
# that lets a caller forge X-Forwarded-For and bypass rate limiting entirely.
TRUST_PROXY_HOPS=0
MAX_FILE_SIZE=15728640
VITE_APP_NAME=NoPS

# --- AI question understanding (optional) ---
# When set, the chat endpoint uses GPT to interpret free-form questions; the
# deterministic engine still computes every number, and only the question + column
# names are sent to OpenAI (never your data rows). Unset = rule-based parser only
# (fully deterministic, no external calls).
OPENAI_API_KEY=
# Model used for interpretation. gpt-5-nano is the cheapest capable default;
# gpt-5-mini or gpt-4.1-mini are more powerful for a modest cost increase.
AI_MODEL=gpt-5-nano

# --- Data-source connectors ---
# Symmetric key used to encrypt saved connection credentials. Required in production.
CONNECTOR_ENCRYPTION_KEY=replace-with-a-long-random-string
# Allow connectors to reach private/loopback hosts (e.g. a local demo DB). Off by default (SSRF guard).
ALLOW_PRIVATE_CONNECTOR_HOSTS=false
# Max rows pulled per connector sync.
MAX_SYNC_ROWS=100000

# --- Uploads ---
# Max rows kept from a single uploaded file (the byte limit alone lets a
# narrow-column file exceed the ~100k-row JSON row-storage assumption).
MAX_UPLOAD_ROWS=100000

# --- Signals: predictions (apps/ml) ---
# The optional Python model service — customer segments, churn risk, product
# affinities. Unset = disabled, the same convention as OPENAI_API_KEY, SMTP_URL and
# STRIPE_SECRET_KEY: the Signals pages say the feature is not switched on for this
# deployment, and nothing else in NoPS is affected in any way.
#
# Every figure it produces is an ESTIMATE from a model, never a measured fact, and
# is kept out of the dashboard, analytics, forecasts and reports on purpose.
ML_ENABLED=false
# Where Node reaches the service. On the loopback default the API spawns and
# supervises the service itself; point this elsewhere and it will not.
ML_SERVICE_URL=http://127.0.0.1:8000
# Shared secret Node sends as the `x-ml-secret` header. The Python service binds
# to 127.0.0.1; this is defence in depth on top of that, and it is required — the
# model routes answer 503 until it is set, and the API refuses to boot with
# ML_ENABLED=true and no secret outside a development environment.
ML_SHARED_SECRET=replace-with-a-long-random-string
# How long Node waits for a model to finish. Training is seconds of work, not
# milliseconds; this bounds a hung service rather than a slow one.
ML_TIMEOUT_MS=120000
# Local development only: run the service with no secret at all. Never set this
# anywhere the port is reachable from another machine.
ML_ALLOW_NO_SECRET=
