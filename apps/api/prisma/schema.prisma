// NoPS database schema.
// Row data is stored as JSON on Dataset (rows / cleanedRows) rather than a
// per-cell table — correct and simple for MVP-size uploads.
// ponytail: JSON row storage; move to a columnar store/warehouse if files grow past ~100k rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum DatasetStatus {
  UPLOADED
  PROFILED
  CLEANED
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum ConnectorType {
  POSTGRES
  MYSQL
  SQLSERVER
  GOOGLE_SHEETS
}

enum ScheduleFrequency {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum Comparator {
  LT
  LTE
  GT
  GTE
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  name         String
  passwordHash String
  // Incremented to invalidate all previously issued JWTs (password reset / logout-all).
  tokenVersion Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  resetTokens  PasswordResetToken[]
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  industry    String               @default("generic") // industry pack key: retail | pharmacy | saas | generic
  plan        String               @default("free")     // billing tier key: free | pro | business
  planStatus  String               @default("active")   // active | past_due | canceled
  // Business calendar (see engine/calendar.ts). The defaults reproduce Gregorian
  // calendar months exactly, so an org that never sets these sees unchanged numbers.
  fiscalYearStartMonth Int         @default(1)          // 1 = January … 12 = December
  periodScheme         String      @default("calendar") // calendar | 445 | 454 | 544
  weekStartDay         Int         @default(1)          // 0 = Sunday … 6 = Saturday; retail schemes only
  stripeCustomerId     String?     // set once the org starts a Stripe checkout
  stripeSubscriptionId String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  datasets    Dataset[]
  reports     Report[]
  forecasts   Forecast[]
  alerts      Alert[]
  conversations AIConversation[]
  apiKeys     ApiKey[]
  connections Connection[]
  activity    ActivityLog[]
  scheduledReports ScheduledReport[]
  alertRules  AlertRule[]
  reportTemplates ReportTemplate[]
  customMetrics   CustomMetric[]
  savedViews      SavedView[]
  cleaningRecipes CleaningRecipe[]
  datasetRelations DatasetRelation[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
}

model Dataset {
  id             String        @id @default(uuid())
  name           String
  fileName       String
  fileType       String
  fileSize       Int
  sourceType     String        @default("upload") // "upload" | "sample" | "connector"
  status         DatasetStatus @default(UPLOADED)
  rowCount       Int           @default(0)
  columnCount    Int           @default(0)
  qualityScore   Int?
  columns        Json          // [{ name, type, semantic, ... }]
  schemaMap      Json          // { revenue: "revenue", date: "order_date", ... }
  profile        Json          // per-column profiling stats
  rows           Json          // original parsed rows
  cleanedRows    Json?         // rows after accepted cleaning suggestions
  // ─── Identity/provenance (see engine/identity.ts) ───
  rawFileHash    String?       // sha256 of the uploaded bytes: "what file was uploaded?"
  datasetHash    String?       // sha256 of the canonical analytical rows: "what was analysed?"
  engineVersion  String?       // engine that ingested/cleaned these rows
  cleaningLog    Json?         // [{ type, column, affectedRows }] applied during cleaning
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  connection     Connection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId   String?
  // The recipe whose steps produced `cleanedRows`. Recorded so appending more data to
  // this dataset can replay the identical transform over the combined rows.
  recipe         CleaningRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  recipeId       String?
  issues         DataQualityIssue[]
  // Relationships this dataset takes part in. Two named relations because both ends
  // point at Dataset; a relation to a deleted dataset means nothing, so both cascade.
  relationsAsLeft  DatasetRelation[] @relation("RelationLeft")
  relationsAsRight DatasetRelation[] @relation("RelationRight")
  reports        Report[]
  forecasts      Forecast[]
  conversations  AIConversation[]
  scheduledReports ScheduledReport[]

  @@index([organizationId])
  @@index([connectionId])
  @@index([recipeId])
}

// An ordered, column-scoped list of cleaning steps (see engine/cleaning.ts), saved so
// the same transform can be replayed against next month's upload. `steps` is a
// CleaningStep[] — each step names its own column and carries its own decisions, so a
// recipe never depends on the issue table of the dataset it was built from.
// At most one recipe per organization has `autoApply` set; that one runs inside the
// shared ingest pipeline, so uploads, samples and connector syncs all get it.
model CleaningRecipe {
  id             String       @id @default(uuid())
  name           String
  steps          Json
  autoApply      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  datasets       Dataset[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// A confirmed join between two of the organization's datasets (see engine/join.ts).
// The analytical read context left-joins each relation onto the base dataset before the
// analytics run; nothing is written back, so every source dataset stays independently
// auditable and removing a relationship restores exactly the numbers the org had.
//
// `kind` is the cardinality MEASURED when the user confirmed the relationship, recorded
// so the evidence panel can state it without re-deriving. Only a unique right-hand key
// is ever stored: a repeated one duplicates each matching left row and inflates every
// total, and modules/relations.ts refuses it at write time rather than warning later.
model DatasetRelation {
  id             String       @id @default(uuid())
  leftColumn     String
  rightColumn    String
  kind           String       // one_to_one | many_to_one (a fan-out join is never stored)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  left           Dataset      @relation("RelationLeft", fields: [leftDatasetId], references: [id], onDelete: Cascade)
  leftDatasetId  String
  right          Dataset      @relation("RelationRight", fields: [rightDatasetId], references: [id], onDelete: Cascade)
  rightDatasetId String

  @@unique([organizationId, leftDatasetId, rightDatasetId, leftColumn, rightColumn])
  @@index([organizationId])
  @@index([leftDatasetId])
  @@index([rightDatasetId])
}

model DataQualityIssue {
  id            String   @id @default(uuid())
  type          String
  column        String?
  affectedRows  Int      @default(0)
  severity      Severity @default(LOW)
  recommendation String
  autoFixable   Boolean  @default(false)
  createdAt     DateTime @default(now())
  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId     String

  @@index([datasetId])
}

model Report {
  id             String       @id @default(uuid())
  title          String
  content        Json         // structured report sections
  // Identification metadata for the computational context that produced this report.
  // NOT a replay capability: a stored hash identifies the inputs, it does not let the
  // engine reconstruct this report after the dataset or engine has changed.
  datasetHash             String?
  engineVersion           String?
  industryKeyAtGeneration String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  dataset        Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetId      String?
  shares         ReportShare[]

  @@index([organizationId])
}

// A public, revocable capability link to one report. Holding the token grants
// read (and PDF) access with no login — see modules/share.ts.
model ReportShare {
  id             String    @id @default(uuid())
  token          String    @unique
  expiresAt      DateTime?  // null = never expires
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  createdById    String?
  report         Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId       String
  organizationId String     // denormalized so the authed list/revoke can scope by org

  @@index([reportId])
  @@index([organizationId])
}

// A named, reusable selection of which report blocks to include when generating.
// `include` is a { summary, kpis, sections, forecast, recommendations } boolean map.
model ReportTemplate {
  id             String       @id @default(uuid())
  name           String
  include        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
}

// A metric defined by the organization rather than by code (see engine/metricSpec.ts).
// `spec` is a declarative MetricSpec — an aggregation kind over one or two named fields
// with at most one filter — never an expression to be evaluated. `key` is what alert
// rules, saved forecasts and URLs reference, so it is unique per organization.
model CustomMetric {
  id             String       @id @default(uuid())
  key            String
  label          String
  spec           Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@unique([organizationId, key])
  @@index([organizationId])
}

// A named analytics filter query, shared by everyone in the organization. `query` is
// the URL query string of the Analytics page (`region=West&dateFrom=…`) — the same
// shape the browser already puts in the address bar, so applying a view is just
// replacing the page's search params. Names are unique per organization so saving
// under an existing name overwrites that view rather than creating a duplicate.
model SavedView {
  id             String       @id @default(uuid())
  name           String
  query          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Forecast {
  id             String       @id @default(uuid())
  // Identification metadata (see Report) — identifies inputs, does not enable replay.
  datasetHash    String?
  engineVersion  String?
  metric         String
  horizon        Int
  method         String
  history        Json         // [{ period, value }]
  points         Json         // [{ period, value, lower, upper }]
  // What-if inputs that produced `points`: { levers, goal, driverDelta }. NULL for a
  // plain forecast, which is what every forecast saved before scenarios existed was.
  scenario       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  dataset        Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetId      String?

  @@index([organizationId])
}

model Alert {
  id             String       @id @default(uuid())
  type           String
  severity       Severity     @default(MEDIUM)
  metric         String
  currentValue   Float?
  threshold      Float?
  description    String
  read           Boolean      @default(false)
  ruleId         String?      // set for custom_alert rows so de-dup survives rule renames
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
  @@index([organizationId, read])
  @@index([organizationId, ruleId, read])
}

model AIConversation {
  id             String       @id @default(uuid())
  title          String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  dataset        Dataset?     @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetId      String?
  messages       AIMessage[]

  @@index([organizationId])
}

model AIMessage {
  id             String         @id @default(uuid())
  role           String         // "user" | "assistant"
  content        String
  data           Json?          // intent + result (table/chart/metrics)
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
}

model ApiKey {
  id             String       @id @default(uuid())
  name           String
  provider       String       @default("openai")
  keyHash        String       // stored hashed, never returned
  lastFour       String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
}

// A saved data-source connector. Credentials are stored AES-GCM encrypted in
// `secret` (never returned to clients); `config` holds only non-secret details.
// Each sync pulls a fresh snapshot into a Dataset via the shared ingest pipeline.
model Connection {
  id             String        @id @default(uuid())
  name           String
  type           ConnectorType
  config         Json          // { host, port, database, user, table } or { sheetUrl }
  secret         String        // encrypted password / token
  lastSyncedAt   DateTime?
  lastSyncStatus String?       // "ok" | "error"
  lastSyncError  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  datasets       Dataset[]

  @@index([organizationId])
}

model ActivityLog {
  id             String       @id @default(uuid())
  action         String
  detail         String?
  actorId        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
}

// A report the scheduler regenerates on a cadence (and optionally emails). The
// deterministic engine builds the content each run, so figures stay reproducible.
model ScheduledReport {
  id             String            @id @default(uuid())
  title          String?
  frequency      ScheduleFrequency @default(WEEKLY)
  enabled        Boolean           @default(true)
  recipients     String[]          @default([]) // email addresses; empty = generate only, no send
  lastRunAt      DateTime?
  lastRunStatus  String?           // "ok" | "error" | "skipped"
  lastError      String?
  nextRunAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  dataset        Dataset?          @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  datasetId      String?

  @@index([organizationId])
  @@index([enabled, nextRunAt])
}

// A user-defined threshold rule the scheduler evaluates against the deterministic
// engine; when the metric crosses the threshold it writes an Alert row.
model AlertRule {
  id              String            @id @default(uuid())
  name            String
  metric          String            // "revenue" | "profit" | "margin" | "orders" | "customers"
  comparator      Comparator
  threshold       Float
  frequency       ScheduleFrequency @default(DAILY)
  enabled         Boolean           @default(true)
  lastRunAt       DateTime?
  lastTriggeredAt DateTime?
  lastError       String?
  nextRunAt       DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String

  @@index([organizationId])
  @@index([enabled, nextRunAt])
}
