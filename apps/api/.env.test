# Local defaults for the integration test suite. Non-secret — safe to commit.
# CI and any real environment override these via actual env vars (loadTestEnv
# never overwrites a variable that is already set).
DATABASE_URL=postgresql://decisioniq:decisioniq@localhost:5432/decisioniq_test?schema=public
JWT_SECRET=test-secret-not-for-production
JWT_EXPIRES_IN=7d
NODE_ENV=test
