# --- NoPS web app (Vite — these are build-time values) ---
# Every VITE_* value is inlined into the public JavaScript bundle at build time. So none
# of them may be a secret, and changing one requires a rebuild + redeploy, not a restart.
# For local development, copy this file to apps/web/.env. For a deployment, set the same
# names in the Vercel project (Settings -> Environment Variables) and redeploy.

# Absolute origin of the API — no trailing slash, and no /api suffix (the client adds
# /api itself). When the UI and the API share an origin, leave it empty.
#   Production (Vercel UI -> separately hosted API): https://api.yourdomain.com
#   Local development: leave empty — Vite's dev server proxies /api to localhost:4000.
VITE_API_URL=

# Brand name shown in the app shell and on the landing page. Unset = "NoPS".
VITE_APP_NAME=NoPS
